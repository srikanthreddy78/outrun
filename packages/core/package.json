{
  "name": "@outrun/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./contracts/index.ts",
    "./db": "./src/db/index.ts",
    "./crew": "./src/crew/index.ts",
    "./fakes": "./src/fakes/index.ts",
    "./integrations": "./src/integrations/index.ts",
    "./crew/tools": "./src/crew/tools/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6"
  }
}
