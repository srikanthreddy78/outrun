# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Real keys live in Vercel and Render env and the Naive vault. Locally, a missing
# integration key falls back to its fake (dev only).

# Neon (Srikanth)
DATABASE_URL=postgres://localhost:5432/outrun_dev
DATABASE_URL_UNPOOLED=postgres://localhost:5432/outrun_dev
APP_URL=http://localhost:3000

# Naive (Srikanth)
NAIVE_API_KEY=
NAIVE_WEBHOOK_SECRET=
CREW_TOKEN_SECRET=

# Models (Srikanth)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Stripe (Srikanth)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monid (Srikanth; a key separate from the CLI's)
MONID_API_KEY=

# AgentMail (Shane)
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=

# HubSpot (Shane)
HUBSPOT_ACCESS_TOKEN=

# Apify (Matthew)
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=

# Dashboard sign-in (Matthew)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_ALLOWLIST=

# The six settings (Srikanth). Unset budget = unlimited.
OUTRUN_LLM_BUDGET_USD_DAILY=
OUTRUN_SEND_DAILY_CAP=30
OUTRUN_DISCOVERY_DAILY_CAP=200
OUTRUN_SMART_MODEL=gpt-5.5
OUTRUN_JOB_MAX_ATTEMPTS=5
OUTRUN_DEMO=true
