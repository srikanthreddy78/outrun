# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Real keys live in Vercel and Render env and the Naive vault. Locally, a missing
# integration key falls back to its fake (dev only).

# Neon (Srikanth)
DATABASE_URL=postgres://localhost:5432/outrun_dev
DATABASE_URL_UNPOOLED=postgres://localhost:5432/outrun_dev
APP_URL=http://localhost:3000

# Naive (Srikanth)
NAIVE_API_KEY=
NAIVE_WEBHOOK_SECRET=
CREW_TOKEN_SECRET=

# Models (Srikanth)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Stripe (Srikanth)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The old signing secret while a rotation is in progress; empty otherwise.
STRIPE_WEBHOOK_SECRET_PREVIOUS=

# Monid (Srikanth; a key separate from the CLI's)
MONID_API_KEY=

# AgentMail (Shane)
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=

# User acquisition Naive project (Shane), user_acquisition/. Both optional.
# The domain the outreach inbox moves to once one is bought or connected in Naive
# (default: the organization's free system subdomain).
OUTREACH_MAIL_DOMAIN=
# Postal address under the unsubscribe link; US commercial email law (CAN-SPAM) requires one.
OUTREACH_MAILING_ADDRESS=

# HubSpot (Shane)
HUBSPOT_ACCESS_TOKEN=

# Apify (Matthew)
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=

# Optional Mobilerun read-only mobile check (Matthew)
MOBILERUN_CLOUD_API_KEY=
MOBILERUN_DEVICE_ID=

# Dashboard sign-in (Matthew)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_ALLOWLIST=

# The six settings (Srikanth). Unset budget = unlimited.
OUTRUN_LLM_BUDGET_USD_DAILY=
OUTRUN_SEND_DAILY_CAP=30
OUTRUN_DISCOVERY_DAILY_CAP=200
OUTRUN_SMART_MODEL=gpt-5.5
OUTRUN_JOB_MAX_ATTEMPTS=5
OUTRUN_DEMO=true
