{
  "name": "naive-hackathon-nov-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "naive": "node --env-file-if-exists=.env node_modules/@usenaive-sdk/cli/dist/index.js",
    "dev": "pnpm --parallel --filter @outrun/web --filter @outrun/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "prepare": "lefthook install || true",
    "db:migrate": "pnpm --filter @outrun/core db:migrate",
    "db:generate": "pnpm --filter @outrun/core db:generate",
    "e2e:loop": "tsx --env-file-if-exists=.env scripts/e2e-loop.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "@usenaive-sdk/cli": "^1.0.0",
    "eslint": "^9.39.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@outrun/core": "workspace:*",
    "@outrun/worker": "workspace:*"
  }
}
